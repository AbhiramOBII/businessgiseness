# Business Giseness — project-root .htaccess
# On cPanel the document root is this folder (not /public), so this file must
# (1) enforce the canonical URL and (2) make sure only /public is reachable.

# Never serve dotfiles (.env, .git, …), even if mod_rewrite is unavailable
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1) Canonical URL: https://www.businessgiseness.com (production domain only,
    #    so localhost and staging are unaffected). One redirect hop in every case.
    RewriteCond %{HTTP_HOST} ^businessgiseness\.com$ [NC]
    RewriteRule ^ https://www.businessgiseness.com%{REQUEST_URI} [R=301,L]

    RewriteCond %{HTTP_HOST} ^www\.businessgiseness\.com$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://www.businessgiseness.com%{REQUEST_URI} [R=301,L]

    # 2) Let SSL certificate validation (AutoSSL / Let's Encrypt) through untouched
    RewriteRule ^\.well-known/ - [L]

    # 3) Old links that include /public/ → clean URL
    RewriteCond %{THE_REQUEST} \s/+public/ [NC]
    RewriteRule ^public/(.*)$ /$1 [R=301,L]

    # 4) Remove trailing slashes (done here so /public never leaks into the URL)
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} !-d
    RewriteRule ^ %1 [R=301,L]

    # 5) Serve everything from /public — nothing else in this folder is reachable
    RewriteRule ^(?!public/)(.*)$ public/$1 [L]
</IfModule>
