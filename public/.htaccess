DirectoryIndex index.php

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Canonical URL: https://www.businessgiseness.com (production domain only).
    # Repeated from the root .htaccess, which Apache skips for requests that
    # land directly in this folder (and in case the document root is /public).
    RewriteCond %{HTTP_HOST} ^businessgiseness\.com$ [NC]
    RewriteRule ^ https://www.businessgiseness.com%{REQUEST_URI} [R=301,L]

    RewriteCond %{HTTP_HOST} ^www\.businessgiseness\.com$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://www.businessgiseness.com%{REQUEST_URI} [R=301,L]

    # URLs that expose /public/ → clean URL (only when /public/ was typed, so no loop)
    RewriteCond %{THE_REQUEST} \s/+public/ [NC]
    RewriteRule ^(.*)$ /$1 [R=301,L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
